                ? 'bg-black border-yellow-400 text-yellow-300'
                : 'bg-slate-900 border-slate-700 text-slate-100'
            }`}
          >
            <div className="flex items-start justify-between gap-3 pb-4 border-b border-slate-800">
              <div className="flex items-center gap-2.5">
                <Languages className="w-6 h-6 text-indigo-400" />
                <div>
                  <h3 className="text-lg font-black text-white">
                    {DICTIONARY[selectedLanguage].title}
                  </h3>
                  <p className="text-xs text-slate-400">{DICTIONARY[selectedLanguage].subtitle}</p>
                </div>
              </div>
              <button
                onClick={() => setShowDictionaryModal(false)}
                className="p-1 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            {/* Language Selector Pills */}
            <div className="flex items-center gap-2 my-4">
              {[
                { code: 'pt', label: 'Português 🇵🇹' },
                { code: 'en', label: 'English 🇬🇧' },
                { code: 'fr', label: 'Français 🇫🇷' },
                { code: 'uk', label: 'Українська 🇺🇦' }
              ].map((lang) => (
                <button
                  key={lang.code}
                  onClick={() => setSelectedLanguage(lang.code)}
                  className={`px-3 py-1.5 rounded-lg text-xs font-bold border transition ${
                    selectedLanguage === lang.code
                      ? 'bg-indigo-600 text-white border-indigo-500'
                      : 'bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-750'
                  }`}
                >
                  {lang.label}
                </button>
              ))}
            </div>

            {/* Terms List */}
            <div className="space-y-3 mt-2">
              {DICTIONARY[selectedLanguage].terms.map((item, idx) => (
                <div
                  key={idx}
                  className="p-3.5 rounded-xl bg-slate-950/60 border border-slate-800 flex items-start gap-3"
                >
                  <span className="text-2xl shrink-0">{item.icon}</span>
                  <div className="space-y-0.5">
                    <h4 className="font-extrabold text-sm text-amber-300">{item.word}</h4>
                    <p className="text-xs sm:text-sm text-slate-300 leading-relaxed">
                      {item.simple}
                    </p>
                  </div>
                </div>
              ))}
            </div>

            <div className="mt-6 pt-4 border-t border-slate-800 flex justify-end">
              <button
                onClick={() => setShowDictionaryModal(false)}
                className="px-5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs"
              >
                Fechar Glossário
              </button>
            </div>
          </div>
        </div>
      )}

      {}
      <footer className="mt-12 border-t border-slate-850 py-6 text-center text-xs text-slate-500">
        <div className="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p>
            Desenvolvido para Cidadania e Desenvolvimento • 2.º e 3.º Ciclos do Ensino Básico (DUA)
          </p>
          <div className="flex items-center gap-4">
            <button
              onClick={handleResetProgress}
              className="text-slate-500 hover:text-rose-400 flex items-center gap-1 transition"
              title="Reiniciar a missão para uma nova turma"
            >
              <RotateCcw className="w-3.5 h-3.5" /> Reiniciar Progresso
            </button>
            <span>Educação para os Direitos Humanos</span>
          </div>
        </div>
      </footer>
    </div>
  );
}
