class SoundFX {
  constructor() {
    this.ctx = null;
    this.enabled = true;
  }

  init() {
    if (!this.ctx && typeof window !== 'undefined') {
      const AudioCtx = window.AudioContext || window.webkitAudioContext;
      if (AudioCtx) {
        this.ctx = new AudioCtx();
      }
    }
  }

  playBeep(freq = 440, type = 'sine', duration = 0.15) {
    if (!this.enabled) return;
    try {
      this.init();
      if (!this.ctx) return;
      if (this.ctx.state === 'suspended') {
        this.ctx.resume();
      }
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
      gain.gain.setValueAtTime(0.12, this.ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);
      osc.connect(gain);
      gain.connect(this.ctx.destination);
      osc.start();
      osc.stop(this.ctx.currentTime + duration);
    } catch {
      // Audio context silently falls back
    }
  }

  playSuccess() {
    if (!this.enabled) return;
    this.playBeep(523.25, 'triangle', 0.1);
    setTimeout(() => this.playBeep(659.25, 'triangle', 0.1), 100);
    setTimeout(() => this.playBeep(783.99, 'triangle', 0.25), 200);
  }

  playError() {
    if (!this.enabled) return;
    this.playBeep(220, 'sawtooth', 0.2);
    setTimeout(() => this.playBeep(180, 'sawtooth', 0.25), 150);
  }

  playFanfare() {
    if (!this.enabled) return;
    const notes = [440, 554.37, 659.25, 880, 783.99, 880];
    notes.forEach((freq, idx) => {
      setTimeout(() => this.playBeep(freq, 'sine', 0.35), idx * 160);
    });
  }
}

