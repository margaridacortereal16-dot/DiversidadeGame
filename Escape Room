function normalizeAnswer(str = '') {
  return str
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[.,\/#!$%\^&\*;:{}=\-_`~()]/g, '')
    .trim();
}

function isAnswerCorrect(userAns, expectedAns) {
  const normUser = normalizeAnswer(userAns);
  const normExpected = normalizeAnswer(expectedAns);
  if (normUser === normExpected) return true;
  // If the user's answer is a significant part of the expected phrase
  if (normExpected.length > 8 && normUser.length > 5 && normExpected.includes(normUser)) {
    return true;
  }
  return false;
}

